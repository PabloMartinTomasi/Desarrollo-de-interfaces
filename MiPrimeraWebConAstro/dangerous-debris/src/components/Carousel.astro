---
const { items = [] } = Astro.props;
---

<div class="carousel">
  <div class="carousel-track">
    {items.map((item: { img: string }) => (
      <img src={item.img} alt="Imagen del carrusel" />
    ))}
  </div>
</div>

<style>
.carousel {
  width: 100%;
  overflow-x: auto;
  padding: 1rem 0;
}

.carousel-track {
  display: flex;
  gap: 1rem;
  overflow-x: scroll;
  scroll-snap-type: x mandatory;
}

.carousel-track img {
  width: 280px;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  scroll-snap-align: center;
}
</style>
