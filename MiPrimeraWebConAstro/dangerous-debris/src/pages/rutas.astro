---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="container mt-4">

    <h1 class="text-center mb-4">Rutas de Senderismo</h1>

    <div class="row g-4">

      <!-- CARD 1 -->
      <div class="col-md-4">
        <div class="card h-100 shadow">
          <img src="/ruta1.png" class="card-img-top" alt="Ruta 1">
          <div class="card-body">
            <h5 class="card-title">Bosque del Silencio</h5>
            <p class="card-text">
              Un sendero tranquilo rodeado de naturaleza y aire puro.
            </p>
            <ul class="list-group list-group-flush text-start">
              <li class="list-group-item"><strong>Dificultad:</strong> Baja</li>
              <li class="list-group-item"><strong>Duración:</strong> 1 h 20 min</li>
              <li class="list-group-item"><strong>Distancia:</strong> 4.5 km</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CARD 2 -->
      <div class="col-md-4">
        <div class="card h-100 shadow">
          <img src="/ruta1.png" class="card-img-top" alt="Ruta 2">
          <div class="card-body">
            <h5 class="card-title">Mirador del Águila</h5>
            <p class="card-text">
              Ruta panorámica con vistas espectaculares del valle.
            </p>
            <ul class="list-group list-group-flush text-start">
              <li class="list-group-item"><strong>Dificultad:</strong> Media</li>
              <li class="list-group-item"><strong>Duración:</strong> 3 h</li>
              <li class="list-group-item"><strong>Distancia:</strong> 8 km</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CARD 3 -->
      <div class="col-md-4">
        <div class="card h-100 shadow">
          <img src="/ruta1.png" class="card-img-top" alt="Ruta 3">
          <div class="card-body">
            <h5 class="card-title">Cascada del Robledal</h5>
            <p class="card-text">
              Un recorrido hasta una cascada escondida en el bosque.
            </p>
            <ul class="list-group list-group-flush text-start">
              <li class="list-group-item"><strong>Dificultad:</strong> Media</li>
              <li class="list-group-item"><strong>Duración:</strong> 2 h 30 min</li>
              <li class="list-group-item"><strong>Distancia:</strong> 6 km</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CARD 4 -->
      <div class="col-md-4">
        <div class="card h-100 shadow">
          <img src="/ruta1.png" class="card-img-top" alt="Ruta 4">
          <div class="card-body">
            <h5 class="card-title">Pico de la Silla</h5>
            <p class="card-text">
              Ascenso exigente para senderistas experimentados.
            </p>
            <ul class="list-group list-group-flush text-start">
              <li class="list-group-item"><strong>Dificultad:</strong> Alta</li>
              <li class="list-group-item"><strong>Duración:</strong> 5 h</li>
              <li class="list-group-item"><strong>Distancia:</strong> 11 km</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CARD 5 -->
      <div class="col-md-4">
        <div class="card h-100 shadow">
          <img src="/ruta1.png" class="card-img-top" alt="Ruta 5">
          <div class="card-body">
            <h5 class="card-title">Sendero del Río Verde</h5>
            <p class="card-text">
              Ruta suave junto al río, ideal para familias.
            </p>
            <ul class="list-group list-group-flush text-start">
              <li class="list-group-item"><strong>Dificultad:</strong> Baja</li>
              <li class="list-group-item"><strong>Duración:</strong> 1 h 10 min</li>
              <li class="list-group-item"><strong>Distancia:</strong> 3 km</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CARD 6 -->
      <div class="col-md-4">
        <div class="card h-100 shadow">
          <img src="/ruta1.png" class="card-img-top" alt="Ruta 6">
          <div class="card-body">
            <h5 class="card-title">Cueva del Dragón</h5>
            <p class="card-text">
              Un recorrido emocionante entre rocas, cuevas y miradores.
            </p>
            <ul class="list-group list-group-flush text-start">
              <li class="list-group-item"><strong>Dificultad:</strong> Media</li>
              <li class="list-group-item"><strong>Duración:</strong> 2 h</li>
              <li class="list-group-item"><strong>Distancia:</strong> 5 km</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
