---
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel.astro";

const rutasDestacadas = [
  { img: "/img/ruta1.png" },
  { img: "/img/ruta2.png" },
  { img: "/img/ruta3.png" },
  { img: "/img/ruta4.png" },
  { img: "/img/ruta5.png" }
];
---
<BaseLayout>
  <div class="container text-center mt-4">

    <h1 class="mb-3">Bienvenido a Wiki Loc</h1>

    <p class="lead">
      Explora las mejores rutas de senderismo, descubre paisajes increíbles y
      encuentra la aventura perfecta para ti.
    </p>

    <!-- Aquí aparece el carrusel -->
    <Carousel items={rutasDestacadas} />

    <h2 class="mt-4 mb-3">Rutas destacadas</h2>

    <div class="table-responsive mt-4">
      <table class="table table-striped table-bordered w-75 mx-auto">
        <thead class="table-dark">
          <tr>
            <th>Ruta</th>
            <th>Dificultad</th>
            <th>Duración</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td>Sendero del Mirador del Águila</td>
            <td>Media</td>
            <td>3 h</td>
          </tr>

          <tr>
            <td>Camino del Bosque Encantado</td>
            <td>Baja</td>
            <td>1 h 30 min</td>
          </tr>

          <tr>
            <td>Pico de la Silla</td>
            <td>Alta</td>
            <td>5 h</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mt-4">
      Navega por las demás secciones para descubrir más rutas, mapas interactivos, 
      consejos de seguridad y mucho más.
    </p>

  </div>
</BaseLayout>
